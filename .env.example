# Copy to .env and adjust as needed. All values are optional.

# HTTP port (Render injects its own PORT).
PORT=3000

# Absolute paths to the binaries. Leave empty to auto-detect:
# ./bin/yt-dlp, a system yt-dlp, the bundled ffmpeg-static build or a system ffmpeg.
# YTDLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/bin/ffmpeg

# How many conversions run at once.
MAX_CONCURRENT=2

# Reject videos longer than this (seconds). Default: 3 hours.
MAX_DURATION_SECONDS=10800

# Delete finished files after this long (milliseconds). Default: 45 minutes.
JOB_TTL_MS=2700000

# Kill a job that runs longer than this (milliseconds). Default: 20 minutes.
JOB_TIMEOUT_MS=1200000

# Directory for temporary audio files. Defaults to ./tmp.
# WORK_DIR=/tmp/yp3

# Optional cookies for sites that rate-limit datacenter IPs (Netscape cookie file).
# YTDLP_COOKIES_FILE=/app/cookies.txt

# Optional yt-dlp extractor arguments, e.g. a different YouTube player client.
# YTDLP_EXTRACTOR_ARGS=youtube:player_client=android,web
