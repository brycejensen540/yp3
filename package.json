{
  "name": "yp3",
  "version": "1.0.0",
  "private": true,
  "description": "Convert video links into high quality 320 kbps MP3 downloads.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "setup:ytdlp": "node scripts/fetch-ytdlp.mjs"
  },
  "keywords": [
    "mp3",
    "converter",
    "youtube",
    "yt-dlp",
    "ffmpeg"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
